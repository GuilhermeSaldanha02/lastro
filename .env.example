# Copie para .env.local e preencha com valores reais.
# .env.local nunca é commitado (.gitignore).

# Supabase — projeto hospedado tbkzcqfvafznxallyfqk (Project Settings > API).
# NEXT_PUBLIC_SUPABASE_ANON_KEY é a chave publishable, protegida por RLS —
# segura no cliente. NUNCA usar aqui a service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — SÓ para excluir a própria conta (ADR-010,
# src/lib/supabase/cliente-admin.ts). Ignora RLS. Nunca prefixar com
# NEXT_PUBLIC_. Pegar em Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — gerar em aistudio.google.com/apikey. Usada só no servidor
# (src/app/api/analise/gemini.ts) — nunca chega ao bundle do cliente (FF1/FF2).
GEMINI_API_KEY=
