# Segredos — a chave da Gemini e as credenciais do Supabase são o ativo
# mais sensível do projeto. Nada de .env entra no git.
.env
.env.*
!.env.example

# Credencial do usuário de QA persistente (docs/qa-acesso.md explica o que é;
# a senha em si nunca entra no git).
.qa-credentials.local

# Dependências e build
node_modules/
.next/
dist/
out/
.vercel/
tsconfig.tsbuildinfo

# Testes
coverage/
playwright-report/
test-results/
.playwright/
playwright/.cache/
blob-report/

# Supabase local
supabase/.temp/
supabase/.branches/

# Sistema
.DS_Store
Thumbs.db
*.log

# Artefatos de sessão — mockups renderizados, previews e scripts de captura.
# Não são entregáveis: tudo em public/ é servido na raiz do site pelo Next,
# então commitar mockup aqui é publicá-lo.
public/0*_*.png
public/preview-*.html
public/preview_*.png
public/comparacao_*.png
scripts/crop-logo.mjs
scripts/render-redesign-mockups.mjs
scripts/render-temas.mjs
docs/PROMPT-PROXIMO-CHAT.md
backups/
docs/screenshots/jornada-usuario/
.superpowers/
.worktrees/

# Saída regenerável da bancada (scripts/preview/pdf.render.tsx).
qa/evidencias/pdf-parecer-*.pdf
qa/evidencias/pdf-milhar.pdf
qa/evidencias/*.png
qa/evidencias/direcao-*.pdf

# Fontes baixadas e cortes intermediários do PDF (scripts/fontes-pdf).
# Regeneráveis: instanciar.py baixa e corta; o que VAI pro repo é só o
# src/lib/pdf/fontes.ts que embutir.mjs produz.
scripts/fontes-pdf/saida/
